{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    "module": "NodeNext",
    "target": "es2020",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
